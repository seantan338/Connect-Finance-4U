# =====================================================================
# Connect Finance 4U — environment template
# Copy to .env and fill real values. .env is gitignored (铁律: 不提交凭证).
# =====================================================================

# --- PostgreSQL (Zeabur) — Financial truth. 余额永远从分录推导。 ---
# Migration / admin connection (owns objects, can CREATE ROLE / triggers).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Runtime application connection — MUST use the restricted `ledger_app` role.
# audit_log 对该角色只有 SELECT,write/update/delete 被 REVOKE(铁律 5)。
APP_DATABASE_URL=postgres://ledger_app:PASSWORD@HOST:PORT/DBNAME

# --- Firebase (Experience layer only: Auth / 实时 / Storage) ---
# 绝不存 financial truth。仅用于 app_users.firebase_uid 桥接。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- MyInvois (e-Invoice) — 不设 = mock transport(本地演示)。详见 docs/compliance-einvoice.md ---
# MYINVOIS_ENV=sandbox            # sandbox | prod;设了才走真 HTTP(需 G7 数字证书)
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=
# Supplier profile(缺口 G1:org 暂无 address/MSIC/phone,从这里注入)
MYINVOIS_SUPPLIER_MSIC=62010
MYINVOIS_SUPPLIER_PHONE=+60123456789
MYINVOIS_SUPPLIER_ADDR=Demo address, JB
MYINVOIS_SUPPLIER_CITY=Johor Bahru
MYINVOIS_SUPPLIER_POSTCODE=80000
MYINVOIS_SUPPLIER_STATE=01
