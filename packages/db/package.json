{
  "name": "@cf4u/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema + migrations. Translated from docs/schema.sql — preserves all CHECK / trigger / role.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "verify": "tsx --env-file=../../.env src/verify.ts",
    "set-app-password": "tsx --env-file=../../.env src/set-app-password.ts",
    "seed": "tsx --env-file=../../.env src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
